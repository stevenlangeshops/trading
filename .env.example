# Kopiere diese Datei nach .env und trage deine Werte ein:
#   cp .env.example .env
#   nano .env
# (wird von python-dotenv automatisch geladen)

# ── Telegram (erforderlich fuer daily_scan_report.py) ─────────────────────────
# Token vom @BotFather, Chat-ID via @userinfobot oder deploy/get_chat_id.py
TELEGRAM_TOKEN=DEIN_TOKEN_HIER
TELEGRAM_CHAT_ID=DEINE_CHAT_ID

# ── Alpaca (nur fuer Live/Paper-Trading, nicht fuer Scanner benoetigt) ─────────
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# APCA_PAPER=true

# ── Optional: Exchange-Schluessel (Krypto, Altprojekt) ────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
